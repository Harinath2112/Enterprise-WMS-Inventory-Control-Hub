# ==============================================================================
# Enterprise WMS Frontend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env for local development.
# In Vercel, configure these variables in: Project Settings > Environment Variables.
#
# SECURITY NOTICE:
# Vite exposes all VITE_* variables in client bundles. NEVER put private keys,
# JWT signing secrets, database passwords, or third-party API secret keys here.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Base URL
# ------------------------------------------------------------------------------
# Local Development: Use '/api' to proxy requests to Django via Vite dev server.
# Production (Vercel): Set to the public HTTPS URL of your Render Django backend.
# Example: https://enterprise-wms-backend.onrender.com/api
# The client automatically ensures the '/api' prefix is normalized without duplicates.
VITE_API_BASE_URL=/api

# ------------------------------------------------------------------------------
# 2. Local Vite Dev Server Proxy Target
# ------------------------------------------------------------------------------
# Only used by vite.config.js during local development (npm run dev).
# Ignored during production builds on Vercel.
VITE_API_PROXY_TARGET=http://localhost:8000
