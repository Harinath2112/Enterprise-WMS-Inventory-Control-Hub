# Copy this file to ".env" and edit it. ".env" is private and never shared.
DB_ENGINE=mysql            # mysql (normal)  |  sqlite (quick test without MySQL)
DB_NAME=imsdatabase
DB_USER=root
DB_PASSWORD=change-me      # <-- your MySQL root password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=0                   # 1 (required for cloud MySQL like Aiven / TiDB) | 0 (local dev)
DB_SSL_CA=                 # optional path to CA cert (e.g. /etc/ssl/certs/aiven-ca.pem)
DB_CONN_MAX_AGE=0          # connection pool age in seconds (0 for Render free tier)

DJANGO_SECRET_KEY=change-me-to-a-long-random-text
DJANGO_DEBUG=1             # 1 (development) | 0 (production on Render)
ALLOWED_HOSTS=             # comma-separated domains, e.g. .onrender.com,localhost
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174  # add production Vercel URL
CSRF_TRUSTED_ORIGINS=      # optional comma-separated HTTPS origins

JWT_KEY=change-me-at-least-32-characters-long-secret-text
JWT_ISSUER=IMSBackend
JWT_AUDIENCE=IMSUsers
LOW_STOCK_THRESHOLD=10

# Cloudinary Storage (Public media: product images, brand logos, user profiles). Leave empty for local disk storage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Cloudflare R2 Storage (Private confidential supplier documents: contracts, GST/PAN, bank docs)
# Uses S3-compatible API. Bucket must remain strictly PRIVATE (no public bucket domain).
# Leave empty for local private disk storage (MEDIA_ROOT/uploads/suppliers).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=               # Optional: defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Transactional Email (Login OTP, verification, invoices)
# Option A: HTTPS API (Preferred for Render Free — no outbound SMTP port required)
BREVO_API_KEY=             # Brevo HTTPS API key (Free 300 emails/day)
RESEND_API_KEY=            # Resend HTTPS API key (Free 3,000 emails/month)
# Option B: Standard SMTP (for environments supporting outbound SMTP)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=IMS Inventory System
EMAIL_FROM_ADDRESS=
