# Copy this file to ".env" and edit it. ".env" is private and never shared.
DB_ENGINE=mysql            # mysql (normal)  |  sqlite (quick test without MySQL)
DB_NAME=imsdatabase
DB_USER=root
DB_PASSWORD=change-me      # <-- your MySQL root password
DB_HOST=127.0.0.1
DB_PORT=3306

DJANGO_SECRET_KEY=change-me-to-a-long-random-text
DJANGO_DEBUG=1
JWT_KEY=change-me-at-least-32-characters-long-secret-text
JWT_ISSUER=IMSBackend
JWT_AUDIENCE=IMSUsers
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Email (login OTP, verification, invoices). Leave EMAIL_HOST empty to print the emails in the backend terminal instead.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=IMS Inventory System
LOW_STOCK_THRESHOLD=10
